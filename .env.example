# Backblaze B2 application key with at least listBuckets, listFiles, readFiles,
# writeFiles, and deleteFiles capabilities scoped to your lakeFS data bucket.
# Create one in the B2 console under "Application Keys".
AWS_ACCESS_KEY_ID=<your-B2-application-key-id>
AWS_SECRET_ACCESS_KEY=<your-B2-application-key>

# B2 S3-compatible endpoint for your account's region. The region segment
# (e.g. us-west-004) must match your bucket's region exactly. Find both on
# the bucket detail page in the B2 console.
AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
AWS_DEFAULT_REGION=us-west-004

# Existing B2 bucket that lakeFS will use as its blockstore. Must be empty
# the first time you start lakeFS. lakeFS writes objects under a versioned
# layout inside this bucket; do not place other application data here.
B2_LAKEFS_DATA_BUCKET=<your-empty-b2-bucket>

# Initial lakeFS admin credentials. These are written into lakeFS's local
# auth database on first start and used by the web UI / lakectl. Change
# them before exposing this beyond localhost.
LAKEFS_ADMIN_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
LAKEFS_ADMIN_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Database credentials for the Postgres KV store that lakeFS uses to track
# repos, branches, and commits. Change before production use.
POSTGRES_USER=lakefs
POSTGRES_PASSWORD=lakefs
POSTGRES_DB=lakefs
