# B2 application key scoped to your lakeFS data bucket.
AWS_ACCESS_KEY_ID=<your-B2-application-key-id>
AWS_SECRET_ACCESS_KEY=<your-B2-application-key>

# B2 endpoint and region. Region segment must match the bucket's region.
AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
AWS_DEFAULT_REGION=us-west-004

# Existing B2 bucket lakeFS uses as its blockstore. Must be empty on first start.
B2_LAKEFS_DATA_BUCKET=<your-empty-b2-bucket>

# Initial lakeFS admin credentials. Rotate before exposing beyond localhost.
LAKEFS_ADMIN_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
LAKEFS_ADMIN_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Postgres KV store. Change before production use.
POSTGRES_USER=lakefs
POSTGRES_PASSWORD=lakefs
POSTGRES_DB=lakefs
